# Copy to .env.local for local development, and add the same two values in
# Vercel → Project → Settings → Environment Variables.
#
# Supabase → Project Settings → API Keys. Use the "anon public" (or
# "publishable") key. NEVER put the service_role / secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://wgvyvlrzyhytjhityygr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical site URL for metadata. Leave unset until ksamasar.com is pointed at Vercel.
# NEXT_PUBLIC_SITE_URL=https://www.ksamasar.com

# Optional: WhatsApp verification codes through Twilio. Server-only — never
# add the NEXT_PUBLIC_ prefix to these.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=+14155238886
